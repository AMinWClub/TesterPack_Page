APP_NAME="TestePack_Page"
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=minimal_fastapi
MONGODB_TIMEOUT_MS=5000

# FarazSMS Pattern (only required when sending SMS)
FARAZ_API_KEY=
FARAZ_API_URL=https://api.iranpayamak.com
FARAZ_LINE_NUMBER=
FARAZ_TIMEOUT_SECONDS=15
FARAZ_PATTERN_CODE=

# Tester worker: existing orders collection and tester product identifier
TESTER_ORDERS_COLLECTION=preprocess_orders
TESTER_PACK_PRODUCT_ID=
# Inclusive start; timezone required. This is 2026-10-13T20:30:00Z.
TESTER_SMS_START_AT=2026-10-14T00:00:00+03:30
# Default maximum orders per run; --limit overrides it.
TESTER_WORKER_BATCH_SIZE=50
# false: read-only, no tokens, database writes or SMS submissions
TESTER_SMS_ENABLED=false
# Include the selection route, e.g. https://tester.example.com/s
TESTER_SELECTION_BASE_URL=
# Exact name of the link variable in the approved Faraz pattern
TESTER_PATTERN_LINK_ATTRIBUTE=link
# Generate once: secrets.token_urlsafe(48); keep stable and confidential
TESTER_TOKEN_SECRET=
