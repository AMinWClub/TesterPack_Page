APP_NAME="TestePack_Page"
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=minimal_fastapi
MONGODB_TIMEOUT_MS=5000

# FarazSMS Simple SMS (only required when sending SMS)
FARAZ_API_KEY=
FARAZ_API_URL=https://api.iranpayamak.com
FARAZ_LINE_NUMBER=
FARAZ_TIMEOUT_SECONDS=15

# Tester worker: only orders whose state is exactly the string "pending"
TESTER_ORDERS_COLLECTION=preprocess_orders
# Default maximum orders per run; --limit overrides it.
TESTER_WORKER_BATCH_SIZE=50
# false: SMS phase is read-only; release also stays off unless explicitly enabled below
TESTER_SMS_ENABLED=false
# Empty/unset follows TESTER_SMS_ENABLED. true enables release even when SMS is disabled.
# false pauses release independently. Dry Run always forbids all writes.
TESTER_RELEASE_ENABLED=
TESTER_RELEASE_BATCH_SIZE=50
# Shared API/worker window from accepted_at; existing frozen intents keep their deadline.
TESTER_SELECTION_WINDOW_MINUTES=30
# Both {full_name} and {link} are required; no other placeholders. Quoted \n becomes a real line break.
TESTER_SMS_TEMPLATE="راستی اینو یادم رفتتتت\n\n{full_name} عزیز، اون عطرهایی که می‌گفتی «باید امتحان کنم» کدوما بودن؟\n\nتسترهای دلخواهت رو تا نیم ساعت دیگه اینجا انتخاب کن که همراه سفارشت برات بفرستیم:\n\n{link}\n\nعطر سراد"
# Origin only, e.g. https://tester.example.com (no path; token is appended at root)
TESTER_SELECTION_BASE_URL=
# Generate once: secrets.token_urlsafe(48); keep stable and confidential
TESTER_TOKEN_SECRET=
# Retry all unconfirmed sends, including ambiguous outcomes; duplicates possible.
TESTER_SMS_RETRY_DELAY_MINUTES=5
TESTER_SMS_MAX_ATTEMPTS=3

# Context + Submit requests per client IP, per process, per minute (1..1000).
TESTER_SELECTION_RATE_LIMIT_PER_MINUTE=60
